    }
  },
  "explanation": {
    "ko": [
      "just는 '방금, 막'이라는 뜻입니다. 조금 전에 끝난 일을 말할 때 씁니다.",
      "just 뒤에 과거형을 씁니다. got home = 집에 도착했다.",
      "'집에 오다'는 get home, come home입니다. home 앞에는 to를 쓰지 않습니다.",
      "'지금 막'이라고 할 때 now를 쓰지 않고 just를 씁니다."
    ],
    "en": "Use \"just\" with a past verb to talk about something that happened a moment ago. Say \"get home,\" not \"get to home.\"",
    "enKo": "\"just\"와 과거형 동사를 함께 쓰면 조금 전에 있었던 일을 말할 수 있습니다. \"get to home\"이 아니라 \"get home\"이라고 합니다."
  },
  "pronunciation": [
    {
      "focus": "약화",
      "tip": "just의 t는 거의 빠지고 got에 붙어 '저스갓'처럼 들립니다."
    },
    {
      "focus": "연음",
      "tip": "got home은 got의 t에서 살짝 멈췄다가 '갓호움'처럼 이어 말합니다."
    },
    {
      "focus": "한국인이 어려운 소리",
      "tip": "home의 o는 '홈'이 아니라 '호움'처럼 입을 오므리며 끝냅니다."
    },
    {
      "focus": "강세",
      "tip": "JUST, GOT, HOME에 고르게 힘을 줍니다. just를 살짝 더 세게 하면 '막' 왔다는 느낌이 납니다."
    }
  ],
  "commonMistakes": [
    {
      "wrong": "I just got to home.",
      "right": "I just got home.",
      "note": "home 앞에는 to를 쓰지 않습니다."
    },
    {
      "wrong": "I just get home.",
      "right": "I just got home.",
      "note": "방금 일어난 일이라 과거형 got을 씁니다."
